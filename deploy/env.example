# Переменные окружения для systemd-юнита. Формат простой: КЛЮЧ=значение,
# без export и без кавычек. Файл читается только root и пользователем pari.
# После правки: systemctl restart pari-mixer

# Домен сайта. Используется скриптом установки для конфига nginx.
APP_DOMAIN=

# База лежит вне каталога с кодом, чтобы обновление кода её не трогало.
TOURNAMENT_DB=/var/lib/pari-mixer/tournament.db

# Официальный ключ Steam Web API: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Ключи доступа через запятую. Кому какой выдан - ведите отдельно.
ACCESS_KEYS=

# Задать ОБЯЗАТЕЛЬНО и не менять: им подписываются сессии. По умолчанию он
# выводится из самого набора ключей, и тогда любая правка ACCESS_KEYS
# разлогинивает всех разом.
AUTH_SECRET=

# Защищает /api/collect, /api/backup и /api/archive. Тот же токен должен
# лежать в секретах GitHub под именем OPS_TOKEN.
OPS_TOKEN=

# 1 - прошедшие кубки открыты всем, текущий по ключу. Пусто - весь сайт по ключу.
PUBLIC_ARCHIVE=1

# Сессионная кука - это и есть платный доступ. За сертификатом от certbot её
# нельзя отдавать по открытому HTTP. Включать после того, как заработает HTTPS.
SESSION_COOKIE_SECURE=1

# Сколько устройств на один ключ.
MAX_DEVICES_PER_KEY=2

# Как часто сам себя запускает сбор. На постоянном сервере процесс не
# засыпает, так что таймер наконец тикает по-настоящему.
COLLECT_INTERVAL_SECONDS=600

# Названия кубков, если понадобится добавить следующий:
# MIXER_TOURNAMENT_LABELS=29:PARI Mixer Cup #4
